{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultrafoot 26",
  "version": "1.0.188",
  "identifier": "com.ultrafoot.remake",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Ultrafoot 26",
        "url": "splash/",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "shadow": true,
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "licenseFile": "installer/LICENSE.txt",
    "resources": {
      "../public/jogadores/**/*": "jogadores/",
      "../public/camisas/**/*": "camisas/",
      "../public/camisas2/**/*": "camisas2/",
      "../public/camisas3/**/*": "camisas3/",
      "../public/escudos/**/*": "escudos/",
      "../public/escudos-mini/**/*": "escudos-mini/",
      "../public/escudos-selecoes/**/*": "escudos-selecoes/",
      "../public/selecoes/**/*": "selecoes/",
      "../public/trofeus/**/*": "trofeus/",
      "../public/kits-imported/**/*": "kits-imported/",
      "../public/audio/commentary/**/*": "audio/commentary/",
      "resources/prerequisites/vc_redist.x64.exe": "prerequisites/vc_redist.x64.exe",
      "resources/extractor/7z.exe": "extractor/7z.exe",
      "resources/extractor/7z.dll": "extractor/7z.dll",
      "resources/extractor/License.txt": "extractor/License.txt",
      "resources/launcher/*": "launcher/",
      "vendor/discord-social-sdk/License-Notices.txt": "Discord-Social-SDK-License-Notices.txt"
    },
    "publisher": "Ultrafoot Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      },
      "wix": {
        "language": "pt-BR"
      }
    },
    "shortDescription": "Ultrafoot 26 - Football Manager",
    "longDescription": "Ultrafoot 26 é um jogo de gerenciamento de futebol com times do mundo inteiro.",
    "copyright": "Copyright © 2026 Ultrafoot Studio"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNDU2ODFGOUM4QUMwNDMKUldSRHdJcWNIMmhGRUc2VnhERnFDMHQwSDU4WGRaSWZLS213Z0wzSnhLS1Yvd3kwRWpvd20zRksK",
      "endpoints": [
        "https://github.com/jovemegidio/Ultrafoot26/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
