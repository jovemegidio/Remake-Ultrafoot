{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backup",
    "Backup Jogo",
    "dev",
    "dist",
    "Remake VIII",
    "Remake X",
    "electron",
    "out",
    ".next",
    ".next (1)",
    "(1).next",
    "(2).next",
    "(3).next",
    "(4).next",
    "(5).next",
    ".node_modules-broken-*",
    "BF2026-27",
    "propostas-de-selecao",
    "src-tauri",
    "services",
    "Launcher"
  ]
}
