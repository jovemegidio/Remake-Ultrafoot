[Unit]
Description=Ultrafoot Cloud Save API
After=network.target

[Service]
Type=simple
User=ultrafoot
Group=ultrafoot
Environment=ULTRAFOOT_SAVE_DIR=/var/lib/ultrafoot/saves
Environment=ULTRAFOOT_SAVE_PORT=8788
ExecStart=/usr/bin/python3 /opt/ultrafoot/cloud-save/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ultrafoot

[Install]
WantedBy=multi-user.target
