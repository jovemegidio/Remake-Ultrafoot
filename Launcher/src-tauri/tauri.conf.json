{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultrafoot Launcher",
  "version": "1.0.38",
  "identifier": "com.ultrafoot.launcher",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm --config.strict-dep-builds=false --config.verify-deps-before-run=false build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Ultrafoot Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "center": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://ultrafoot.179-198-103-30.sslip.io https://github.com https://*.github.com https://api.github.com https://objects.githubusercontent.com https://raw.githubusercontent.com; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Ultrafoot Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English",
          "Spanish",
          "SpanishInternational",
          "Portuguese",
          "French",
          "German",
          "Italian",
          "Dutch",
          "Polish",
          "Russian",
          "Ukrainian",
          "Turkish",
          "Arabic",
          "Japanese",
          "Korean",
          "SimpChinese",
          "TradChinese",
          "Indonesian",
          "Vietnamese",
          "Thai",
          "Hindi",
          "Czech",
          "Swedish",
          "Norwegian",
          "Danish",
          "Finnish",
          "Greek",
          "Hebrew",
          "Hungarian",
          "Romanian",
          "Bulgarian",
          "Croatian",
          "Serbian",
          "Slovak",
          "Slovenian",
          "Catalan",
          "Galician",
          "Basque",
          "Estonian",
          "Latvian",
          "Lithuanian",
          "Albanian",
          "Macedonian",
          "Malay",
          "Farsi",
          "Afrikaans",
          "Belarusian",
          "Bosnian",
          "Icelandic",
          "Irish",
          "Georgian",
          "Armenian",
          "Uzbek",
          "Kurdish",
          "Mongolian",
          "Pashto",
          "Tatar",
          "Welsh",
          "Asturian",
          "Breton",
          "Corsican",
          "Esperanto",
          "Luxembourgish",
          "NorwegianNynorsk",
          "ScotsGaelic",
          "SerbianLatin"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
